# =====================================================================
# Environment variables — copy to `.env.local` and fill in real values.
# Never commit real secrets. This file documents variable names only.
# =====================================================================

# ---- Clerk — authentication for resume access ----
# Dashboard: https://dashboard.clerk.com  →  API Keys
# The publishable key is safe for the browser; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Neon — Postgres (audit log / future persistent data) ----
# Dashboard: https://neon.tech  →  Connection Details  →  pooled connection string
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# =====================================================================
# Notes
# - `next dev` / `next build` read from `.env.local`.
# - On Render, set these same variables under Dashboard → your service →
#   Environment. They are available at build time, so
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is correctly inlined into the client bundle.
# =====================================================================
